# Python and build products
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.vscode/

# Local data: retain only stage identity files
/data/**
!/data/stage1/
!/data/stage2/
!/data/stage3/
!/data/stage1/metadata.json
!/data/stage2/metadata.json
!/data/stage3/metadata.json

# Runtime experiment outputs
# Includes run_config.yaml, metadata.json, summary.json,
# attempts.jsonl, checkpoints, metrics, artifacts, etc.
/outputs/

# Historical and local research payloads
/artifacts/
/trash/

# Heavy or transient payloads anywhere else
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz
*.parquet
*.arrow
*.feather
*.h5
*.hdf5
*.pkl
*.joblib
*.log
*.tmp
metrics.jsonl
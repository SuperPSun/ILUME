# Python and build products
__pycache__/
*.py[cod]
*.egg-info/
/.pytest_cache/
/build/
/dist/
/.vscode/

# Local data: retain only stage identity files
/data/**
!/data/stage1/
!/data/stage2/
!/data/stage3/
!/data/stage1/metadata.json
!/data/stage2/metadata.json
!/data/stage3/metadata.json

# Self-describing run identities: everything else is payload
/outputs/**
!/outputs/**/
!/outputs/**/run_config.yaml
!/outputs/**/metadata.json
!/outputs/**/summary.json
/outputs/**/artifacts/

# Historical and local research payloads
/artifacts/
/trash/

# Heavy or transient payloads anywhere else
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz
*.parquet
*.arrow
*.feather
*.h5
*.hdf5
*.pkl
*.joblib
*.log
*.tmp
metrics.jsonl
